# ─── Docker Compose (PostgreSQL only) ─────────────────────────────────────────
# These variables are used by docker-compose.yml to provision the database.
# Backend & frontend run locally — configure them via backend/.env.

POSTGRES_USER=preduzetnik
POSTGRES_PASSWORD=preduzetnik
POSTGRES_DB=preduzetnik


# ─── Production (docker-compose.prod.yml) ────────────────────────────────────
# POSTGRES_PASSWORD above must be a strong, URL-safe value in production (letters, digits, - and _).

# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Public URL of the app, used for CORS
APP_URL=http://localhost:8080
# Host port the app is published on
APP_PORT=8080
# Where daily database dumps are written, and how many days to keep
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
